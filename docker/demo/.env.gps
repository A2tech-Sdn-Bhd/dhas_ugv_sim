# GPS Testing Configuration
# This file configures the environment for GPS testing in Docker
# Copy or reference this for custom GPS configurations

# Display configuration for X11 forwarding
DISPLAY=${DISPLAY:?You need to define display env}

# X11 shared memory configuration
QT_X11_NO_MITSHM=1

# ROS 2 middleware configuration
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Build type for simulation
HUSARION_ROS_BUILD_TYPE=simulation

# Robot configuration
ROBOT_MODEL_NAME=panther
ROBOT_NAMESPACE=panther
ROS_DOMAIN_ID=0

# Gazebo configuration
GZ_LOG_LEVEL=1

# Optional: Verbose ROS logging for GPS debugging
# Uncomment the next two lines for detailed GPS logs
# ROS_LOG_DIR=/ros2_ws/gps_logs
# RCUTILS_LOGGING_OUTPUT_FORMAT="[{time}] [{name}] [{severity}] {message}"

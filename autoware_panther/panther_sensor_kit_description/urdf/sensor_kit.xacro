<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
    <xacro:arg name="config_dir" default="$(find panther_sensor_kit_description)/config"/>
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>

    <link name="sensor_kit_base_link"/>
    <joint name="sensor_kit_base_link_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
      <parent link="${parent}"/>
      <child link="sensor_kit_base_link"/>
    </joint>

    <link name="velodyne_top_base_link"/>
    <joint name="velodyne_top_base_link_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['velodyne_top_base_link']['x']} ${calibration['sensor_kit_base_link']['velodyne_top_base_link']['y']} ${calibration['sensor_kit_base_link']['velodyne_top_base_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['velodyne_top_base_link']['roll']} ${calibration['sensor_kit_base_link']['velodyne_top_base_link']['pitch']} ${calibration['sensor_kit_base_link']['velodyne_top_base_link']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="velodyne_top_base_link"/>
    </joint>

    <link name="velodyne_top"/>
    <joint name="velodyne_top_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="velodyne_top_base_link"/>
      <child link="velodyne_top"/>
    </joint>

    <link name="camera0/camera_link"/>
    <joint name="camera0_camera_link_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['camera0/camera_link']['x']} ${calibration['sensor_kit_base_link']['camera0/camera_link']['y']} ${calibration['sensor_kit_base_link']['camera0/camera_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['camera0/camera_link']['roll']} ${calibration['sensor_kit_base_link']['camera0/camera_link']['pitch']} ${calibration['sensor_kit_base_link']['camera0/camera_link']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="camera0/camera_link"/>
    </joint>

    <link name="camera0/camera_optical_link"/>
    <joint name="camera0_camera_optical_link_joint" type="fixed">
      <origin
        xyz="0 0 0"
        rpy="${calibration['sensor_kit_base_link']['camera0/camera_optical_link']['roll']} ${calibration['sensor_kit_base_link']['camera0/camera_optical_link']['pitch']} ${calibration['sensor_kit_base_link']['camera0/camera_optical_link']['yaw']}"/>
      <parent link="camera0/camera_link"/>
      <child link="camera0/camera_optical_link"/>
    </joint>

    <link name="gnss_base_link"/>
    <joint name="gnss_base_link_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['gnss_base_link']['x']} ${calibration['sensor_kit_base_link']['gnss_base_link']['y']} ${calibration['sensor_kit_base_link']['gnss_base_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['gnss_base_link']['roll']} ${calibration['sensor_kit_base_link']['gnss_base_link']['pitch']} ${calibration['sensor_kit_base_link']['gnss_base_link']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="gnss_base_link"/>
    </joint>

    <link name="imu_link"/>
    <joint name="imu_link_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['imu_link']['x']} ${calibration['sensor_kit_base_link']['imu_link']['y']} ${calibration['sensor_kit_base_link']['imu_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['imu_link']['roll']} ${calibration['sensor_kit_base_link']['imu_link']['pitch']} ${calibration['sensor_kit_base_link']['imu_link']['yaw']}"/>
      <parent link="sensor_kit_base_link"/>
      <child link="imu_link"/>
    </joint>
  </xacro:macro>
</robot>

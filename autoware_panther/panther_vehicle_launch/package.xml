<?xml version="1.0"?>
<package format="3">
  <name>panther_vehicle_launch</name>
  <version>0.1.0</version>
  <description>Autoware vehicle launch integration for the Husarion Panther UGV simulation.</description>
  <maintainer email="user@example.com">DHAS UGV Simulation Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

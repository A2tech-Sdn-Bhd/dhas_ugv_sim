<?xml version="1.0" ?>
<!--
  SDF 1.9 World — Dense Vehicle Storage Lot — Dense Vehicle Storage Lot
  ============================================================
  Mimics the satellite-view of a car marshalling yard / port storage lot.

  HOW TO USE
  ==========
  Gazebo Sim (Ignition / Harmonic):
    gz sim parking_lot_world.sdf

  Gazebo Classic fallback:
    gazebo parking_lot_world.sdf

  ROS 2 launch:
    ros2 launch gazebo_ros gazebo.launch.py world:=parking_lot_world.sdf

  (Optional) For high-fidelity Prius models from Fuel:
    gz fuel download ==url https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius%20Hybrid
    Then replace [uri]model://car_box_*[/uri] with [uri]model://Prius Hybrid[/uri]

  NOTES
  ====-
  - Ground plane has NO road markings or parking lines.
  - Cars are placed in dense irregular clusters matching the reference image.
  - Each car is a static model (no physics / joints needed for a static lot).
  - Sun + ambient light configured for overhead daylight rendering.
-->
<sdf version="1.9">
  <world name="parking_lot">
    <!-- Required GZ Sim systems -->
    <plugin filename="ignition-gazebo-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="ignition-gazebo-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors" />
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands" />

    <!-- GPS / world georeference -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>50.088384</latitude_deg>
      <longitude_deg>19.939128</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ═══════════════════ PHYSICS ═══════════════════ -->
    <physics name="default_physics" default="true" type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- ═══════════════════ SCENE ════════════════════ -->
    <scene>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.55 0.55 0.58 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- ═══════════════════ SUN ══════════════════════ -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 -0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- ═══════════════════ GROUND PLANE (bare asphalt) ══════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 300</size>
            </plane>
          </geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>400 300</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.28 0.27 1</ambient>
            <diffuse>0.32 0.32 0.30 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17</name>
      <pose>4.37573 27.2583 0.012649 -0 0 1.7167</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_1</name>
      <pose>5.0858 1.4144 0.012649 -0 0 0.6667</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_2</name>
      <pose>2.01012 1.60713 0.012649 -0 0 0.6667</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_3</name>
      <pose>-0.651022 1.49412 0.012649 -0 0 0.6667</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_4</name>
      <pose>-3.78018 1.43965 0.01265 -0 0 0.6667</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_5</name>
      <pose>-6.29654 1.01913 0.012649 -0 0 0.6667</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_6</name>
      <pose>10.8759 7.85476 0.012649 -0 -0 0.181124</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_7</name>
      <pose>11.49 2.6635 0.012649 -0 0 0.181124</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_8</name>
      <pose>11.7111 -2.38291 0.012649 -0 0 0.181124</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_9</name>
      <pose>11.7164 -7.36604 0.012649 -0 0 0.181124</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_10</name>
      <pose>9.59429 -11.1857 0.01265 -0 -0 -1.36071</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_11</name>
      <pose>5.22061 -11.2354 0.017518 0.003451 -0 -1.3607</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_12</name>
      <pose>0.124132 -11.1225 0.012649 -0 0 -1.35712</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_13</name>
      <pose>-5.01379 -11.0402 0.012649 -0 0 -1.35712</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_14</name>
      <pose>-9.80895 -10.6276 0.012649 -0 0 -1.35712</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_15</name>
      <pose>-13.7446 -6.69749 0.012649 -0 0 -3.07006</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_16</name>
      <pose>-14.3901 -1.15019 0.012649 -0 0 -3.07006</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_17</name>
      <pose>-14.5197 3.84405 0.012649 -0 0 -3.07006</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_18</name>
      <pose>-14.6051 9.35177 0.012649 -0 0 -3.07006</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_11_1</name>
      <pose>-11.5454 13.4887 0.012649 -0 -0 -1.36015</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_11_2</name>
      <pose>-6.24178 12.0407 0.012649 -0 -0 -1.36015</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_11_3</name>
      <pose>-0.776729 11.1851 0.01265 -0 -0 -1.36015</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_11_4</name>
      <pose>4.42102 12.0481 0.012649 -1e-06 -0 -1.36015</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri>
      <name>prius_0000_2_9_8_17_11_5</name>
      <pose>9.7177 12.6348 0.012649 -1e-06 0 -1.36016</pose>
    </include>
    <!-- GUI camera: top-down aerial view -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 200 0 1.5707 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>orthographic</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
